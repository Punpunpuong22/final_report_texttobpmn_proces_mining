        <di:waypoint x="827" y="472" />
        <di:waypoint x="827" y="102" />
        <di:waypoint x="855" y="102" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_6_di" bpmnElement="P1_Flow_6">
        <di:waypoint x="772" y="320" />
        <di:waypoint x="827" y="320" />
        <di:waypoint x="827" y="190" />
        <di:waypoint x="855" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
