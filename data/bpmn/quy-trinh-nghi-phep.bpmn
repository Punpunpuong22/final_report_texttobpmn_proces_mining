<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://luong.app/bpmn" exporter="Luong" exporterVersion="1.0">
  <bpmn:collaboration id="P1_Collaboration_1" name="Quy trình nghỉ phép">
    <bpmn:participant id="P1_Participant_1" name="Quy trình nghỉ phép" processRef="P1_Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="P1_Process_1" name="Quy trình nghỉ phép" isExecutable="false">
    <bpmn:laneSet id="P1_LaneSet_1">
      <bpmn:lane id="P1_Lane_1" name="Nhân viên">
        <bpmn:flowNodeRef>P1_StartEvent_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_2" name="Quản lý">
        <bpmn:flowNodeRef>P1_Task_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Gateway_x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Task_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_3" name="Nhân sự">
        <bpmn:flowNodeRef>P1_UserTask_u1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_StartEvent_s1" name="Gửi đơn nghỉ phép">
      <bpmn:outgoing>P1_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P1_Task_t1" name="Xem xét đơn">
      <bpmn:incoming>P1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P1_Gateway_x1" name="Quản lý đồng ý?">
      <bpmn:incoming>P1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_UserTask_u1" name="Ghi nhận nghỉ phép">
      <bpmn:incoming>P1_Flow_3</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="P1_Task_t2" name="Ghi lý do từ chối">
      <bpmn:incoming>P1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P1_EndEvent_e1" name="Nhận thông báo đã duyệt">
      <bpmn:incoming>P1_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P1_EndEvent_e2" name="Nhận thông báo từ chối">
      <bpmn:incoming>P1_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_Flow_1" sourceRef="P1_StartEvent_s1" targetRef="P1_Task_t1" />
    <bpmn:sequenceFlow id="P1_Flow_2" sourceRef="P1_Task_t1" targetRef="P1_Gateway_x1" />
    <bpmn:sequenceFlow id="P1_Flow_3" name="Đồng ý" sourceRef="P1_Gateway_x1" targetRef="P1_UserTask_u1" />
    <bpmn:sequenceFlow id="P1_Flow_4" name="Từ chối" sourceRef="P1_Gateway_x1" targetRef="P1_Task_t2" />
    <bpmn:sequenceFlow id="P1_Flow_5" sourceRef="P1_UserTask_u1" targetRef="P1_EndEvent_e1" />
    <bpmn:sequenceFlow id="P1_Flow_6" sourceRef="P1_Task_t2" targetRef="P1_EndEvent_e2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P1_BPMNDiagram_1">
    <bpmndi:BPMNPlane id="P1_BPMNPlane_1" bpmnElement="P1_Collaboration_1">
      <bpmndi:BPMNShape id="P1_Participant_1_di" bpmnElement="P1_Participant_1" isHorizontal="true">
        <dc:Bounds x="56" y="48" width="891" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_3_di" bpmnElement="P1_Lane_3" isHorizontal="true">
        <dc:Bounds x="86" y="396" width="861" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_2_di" bpmnElement="P1_Lane_2" isHorizontal="true">
        <dc:Bounds x="86" y="244" width="861" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_1_di" bpmnElement="P1_Lane_1" isHorizontal="true">
        <dc:Bounds x="86" y="48" width="861" height="196" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_StartEvent_s1_di" bpmnElement="P1_StartEvent_s1">
        <dc:Bounds x="144" y="128" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="108" y="168" width="109" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Task_t1_di" bpmnElement="P1_Task_t1">
        <dc:Bounds x="260" y="280" width="148" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Gateway_x1_di" bpmnElement="P1_Gateway_x1" isMarkerVisible="true">
        <dc:Bounds x="488" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="465" y="349" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_UserTask_u1_di" bpmnElement="P1_UserTask_u1">
        <dc:Bounds x="618" y="432" width="157" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Task_t2_di" bpmnElement="P1_Task_t2">
        <dc:Bounds x="622" y="280" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_EndEvent_e1_di" bpmnElement="P1_EndEvent_e1">
        <dc:Bounds x="855" y="84" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="124" width="147" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_EndEvent_e2_di" bpmnElement="P1_EndEvent_e2">
        <dc:Bounds x="855" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="803" y="212" width="141" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_Flow_1_di" bpmnElement="P1_Flow_1">
        <di:waypoint x="180" y="146" />
        <di:waypoint x="232" y="146" />
        <di:waypoint x="232" y="320" />
        <di:waypoint x="260" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_2_di" bpmnElement="P1_Flow_2">
        <di:waypoint x="408" y="320" />
        <di:waypoint x="460" y="320" />
        <di:waypoint x="488" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_3_di" bpmnElement="P1_Flow_3">
        <di:waypoint x="538" y="320" />
        <di:waypoint x="590" y="320" />
        <di:waypoint x="590" y="472" />
        <di:waypoint x="618" y="472" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="571" y="378" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_4_di" bpmnElement="P1_Flow_4">
        <di:waypoint x="538" y="320" />
