        <di:waypoint x="622" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="544" y="302" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_5_di" bpmnElement="P1_Flow_5">
