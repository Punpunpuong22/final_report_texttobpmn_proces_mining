<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://luong.app/bpmn" exporter="Luong" exporterVersion="1.0">
  <bpmn:collaboration id="P1_Collaboration_1" name="Quy trình tuyển dụng">
    <bpmn:participant id="P1_Participant_1" name="Quy trình tuyển dụng" processRef="P1_Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="P1_Process_1" name="Quy trình tuyển dụng" isExecutable="false">
    <bpmn:laneSet id="P1_LaneSet_1">
      <bpmn:lane id="P1_Lane_1" name="Ứng viên">
        <bpmn:flowNodeRef>P1_StartEvent_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Task_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_2" name="Tuyển dụng">
        <bpmn:flowNodeRef>P1_Task_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Gateway_x1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_3" name="Trưởng bộ phận">
        <bpmn:flowNodeRef>P1_UserTask_u1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Gateway_x2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane_4" name="Nhân sự">
        <bpmn:flowNodeRef>P1_Task_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Task_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_StartEvent_s1" name="Nộp hồ sơ">
      <bpmn:outgoing>P1_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P1_Task_t1" name="Sàng lọc hồ sơ">
      <bpmn:incoming>P1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P1_Gateway_x1" name="Đạt sàng lọc?">
      <bpmn:incoming>P1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P1_EndEvent_e1" name="Nhận thư từ chối">
      <bpmn:incoming>P1_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P1_UserTask_u1" name="Phỏng vấn">
      <bpmn:incoming>P1_Flow_4</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_Gateway_x2" name="Trúng tuyển?">
      <bpmn:incoming>P1_Flow_5</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>P1_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P1_Task_t2" name="Gửi offer">
      <bpmn:incoming>P1_Flow_6</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P1_Task_t3" name="Xác nhận offer">
      <bpmn:incoming>P1_Flow_8</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P1_EndEvent_e2" name="Hoàn tất tuyển dụng">
      <bpmn:incoming>P1_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P1_Task_t4" name="Gửi thư từ chối">
      <bpmn:incoming>P1_Flow_7</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P1_EndEvent_e3" name="Kết thúc">
      <bpmn:incoming>P1_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_Flow_1" sourceRef="P1_StartEvent_s1" targetRef="P1_Task_t1" />
    <bpmn:sequenceFlow id="P1_Flow_2" sourceRef="P1_Task_t1" targetRef="P1_Gateway_x1" />
    <bpmn:sequenceFlow id="P1_Flow_3" name="Không" sourceRef="P1_Gateway_x1" targetRef="P1_EndEvent_e1" />
    <bpmn:sequenceFlow id="P1_Flow_4" name="Đạt" sourceRef="P1_Gateway_x1" targetRef="P1_UserTask_u1" />
    <bpmn:sequenceFlow id="P1_Flow_5" sourceRef="P1_UserTask_u1" targetRef="P1_Gateway_x2" />
    <bpmn:sequenceFlow id="P1_Flow_6" name="Trúng tuyển" sourceRef="P1_Gateway_x2" targetRef="P1_Task_t2" />
    <bpmn:sequenceFlow id="P1_Flow_7" name="Không trúng" sourceRef="P1_Gateway_x2" targetRef="P1_Task_t4" />
    <bpmn:sequenceFlow id="P1_Flow_8" sourceRef="P1_Task_t2" targetRef="P1_Task_t3" />
    <bpmn:sequenceFlow id="P1_Flow_9" sourceRef="P1_Task_t3" targetRef="P1_EndEvent_e2" />
    <bpmn:sequenceFlow id="P1_Flow_10" sourceRef="P1_Task_t4" targetRef="P1_EndEvent_e3" />
  </bpmn:process>
